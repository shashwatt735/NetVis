    ...buttonSizeStyles[resolvedSize],
    ...style
  }

  return (
    <Comp
      data-slot="button"
      className={cn(buttonVariants({ variant, size: resolvedSize, className }))}
      style={nvStyle}
      {...props}
    />
  )
