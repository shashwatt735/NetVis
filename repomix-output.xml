<file path="src/renderer/src/components/CaptureControls.tsx">
import { FastForward, FileDown, FileUp, Play, Square } from 'lucide-react'
import { useState } from 'react'
import type React from 'react'
import type { SpeedMultiplier } from '../../../shared/capture-types'
import { useNetVisStore } from '../store'
import { HelpIcon } from './HelpIcon'
import { StatusPill } from './domain'
import { Button } from './ui/button'
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from './ui/select'

const VALID_SPEEDS: SpeedMultiplier[] = [0.5, 1, 2, 5]

/**
 * Start / Stop / Simulated capture buttons wired to IPC.
 * Import / Export PCAP buttons.
 * Req 1.1, 2.1, 2.2, 2.8, 7.1, 7.2, 7.3, 7.4, 8.1, 8.2, 8.3, 8.4
 */
export function CaptureControls(): React.JSX.Element {
  const captureStatus = useNetVisStore((s) => s.captureStatus)
  const activeInterface = useNetVisStore((s) => s.activeInterface)
  const clearPackets = useNetVisStore((s) => s.clearPackets)
  const addPackets = useNetVisStore((s) => s.addPackets)
  const setImportResult = useNetVisStore((s) => s.setImportResult)
  const [error, setError] = useState<string | null>(null)
  const [importInfo, setImportInfo] = useState<string | null>(null)
  const [exporting, setExporting] = useState(false)
  const [speed, setSpeed] = useState<SpeedMultiplier>(1)

  const isCapturing =
    captureStatus.state === 'active' ||
    captureStatus.state === 'file' ||
    captureStatus.state === 'simulated'

  const handleStart = async (): Promise<void> => {
    if (!activeInterface) {
      setError('Select an interface first')
      return
    }
    setError(null)
    setImportInfo(null)
    setImportResult(null)
    try {
      await window.electronAPI.startCapture(activeInterface)
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to start capture')
    }
  }

  const handleStop = async (): Promise<void> => {
    setError(null)
    try {
      await window.electronAPI.stopCapture()
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to stop capture')
    }
  }

  const handleSimulated = async (): Promise<void> => {
    setError(null)
    setImportInfo(null)
    setImportResult(null)
    try {
      const result = await window.electronAPI.selectPcapFile()
      if (!result.ok) return
      await window.electronAPI.startSimulated(result.path, speed)
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to start simulated replay')
    }
  }

  const handleImport = async (): Promise<void> => {
    setError(null)
    setImportInfo(null)
    setImportResult(null)
    try {
      const result = await window.electronAPI.importPcap()
      if (!result.ok) {
        if (result.error && result.error !== 'User canceled') {
          setError(result.error)
        }
        return
      }

      const packets = await window.electronAPI.getAllPackets()
      clearPackets()
      if (packets.length > 0) addPackets(packets)

      const count = result.packetCount ?? 0
      const sizeBytes = result.fileSizeBytes ?? 0
      setImportResult({ packetCount: count, fileSizeBytes: sizeBytes })

      const sizeLabel = sizeBytes > 0 ? `${(sizeBytes / 1024).toFixed(1)} KB` : null
      setImportInfo(
        `Imported ${count.toLocaleString()} packets${sizeLabel ? ` (${sizeLabel})` : ''}`
      )
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Import failed')
    }
  }

  const handleExport = async (): Promise<void> => {
    setError(null)
    setImportInfo(null)
    setExporting(true)
    try {
      const result = await window.electronAPI.exportPcap()
      if (!result.ok && result.error && result.error !== 'User canceled') {
        setError(result.error)
      }
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Export failed')
    } finally {
      setExporting(false)
    }
  }

  return (
    <div className="flex items-center gap-2">
      {!isCapturing ? (
        <>
          <Button
            size="sm"
            variant="default"
            onClick={handleStart}
            disabled={!activeInterface}
            aria-label="Start live capture"
            className="px-4"
            style={{ backgroundColor: 'var(--proto-tcp)', color: '#fff', border: 'none' }}
          >
            <Play size={14} aria-hidden />
            Start
          </Button>

          <div className="flex items-center gap-1.5">
            <Select
              value={String(speed)}
              onValueChange={(val) => {
                const nextSpeed = Number(val)
                if ((VALID_SPEEDS as number[]).includes(nextSpeed)) {
                  setSpeed(nextSpeed as SpeedMultiplier)
                }
              }}
            >
              <SelectTrigger size="sm" className="w-[84px]" aria-label="Select replay speed">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="0.5">0.5x</SelectItem>
                <SelectItem value="1">1x</SelectItem>
                <SelectItem value="2">2x</SelectItem>
                <SelectItem value="5">5x</SelectItem>
              </SelectContent>
            </Select>
            <HelpIcon helpId="simulated-speed" side="bottom" />
          </div>

          <Button
            size="sm"
            variant="outline"
            onClick={handleSimulated}
            aria-label="Load PCAP file for simulated replay"
            className="px-4"
          >
            <FastForward size={14} aria-hidden />
            Simulated
          </Button>

          <span
            aria-hidden
            style={{
              width: 1,
              height: 20,
              backgroundColor: 'var(--nv-border-default)',
              flexShrink: 0,
              margin: '0 4px'
            }}
          />

          <Button
            size="sm"
            variant="outline"
            onClick={handleImport}
            aria-label="Import PCAP file"
            className="px-4"
          >
            <FileDown size={14} aria-hidden />
            Import
          </Button>

          <Button
            size="sm"
            variant="outline"
            onClick={handleExport}
            disabled={exporting}
            aria-label="Export captured packets to PCAP file"
            className="px-4"
          >
            <FileUp size={14} aria-hidden />
            {exporting ? 'Exporting...' : 'Export'}
          </Button>
        </>
      ) : (
        <Button
          size="sm"
          variant="destructive"
          onClick={handleStop}
          aria-label="Stop capture"
          className="px-4"
        >
          <Square size={12} aria-hidden />
          Stop
        </Button>
      )}

      {error && <StatusPill status="error" label={error} />}
      {!error && importInfo && <StatusPill status="success" label={importInfo} />}
    </div>
  )
}
</file>

<file path="src/renderer/src/components/ChallengePanel.tsx">
/**
 * ChallengePanel — Guided educational challenges.
 * Req 11.1, 11.2, 11.3, 11.4, 11.5
 */

import { useEffect, useRef, useState } from 'react'
import type React from 'react'
import { Trophy, ChevronDown, ChevronRight, X } from 'lucide-react'
import { useNetVisStore } from '../store'
import { getChallengeById } from '../data/challenges'
import { Button } from './ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from './ui/card'
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from './ui/collapsible'
import { toast } from 'sonner'

/**
 * ChallengePanel displays the active challenge with goal, hint, and success evaluation.
 * Evaluates success criteria on 500ms debounced interval (Req 11.3).
 * Persists completion to Settings_Store (Req 11.5).
 */
export function ChallengePanel(): React.JSX.Element {
  const activeChallengeId = useNetVisStore((s) => s.activeChallengeId)
  const completedChallengeIds = useNetVisStore((s) => s.completedChallengeIds)
  const filteredPackets = useNetVisStore((s) => s.filteredPackets)
  const filterExpression = useNetVisStore((s) => s.filterExpression)
  const activateChallenge = useNetVisStore((s) => s.activateChallenge)
  const setCompletedChallenges = useNetVisStore((s) => s.setCompletedChallenges)

  const [hintRevealed, setHintRevealed] = useState(false)
  const [isEvaluating, setIsEvaluating] = useState(false)
  const evaluationTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)
  const lastEvaluationRef = useRef<number>(0)
  const completionInFlightRef = useRef<string | null>(null)

  const activeChallenge = activeChallengeId ? getChallengeById(activeChallengeId) : null

  const handleChallengeSuccess = async (id: string, title: string): Promise<void> => {
    const currentCompletedIds = useNetVisStore.getState().completedChallengeIds

    if (currentCompletedIds.includes(id) || completionInFlightRef.current === id) {
      return
    }

    completionInFlightRef.current = id

    try {
      const newCompletedIds = Array.from(new Set([...currentCompletedIds, id]))
      await window.electronAPI.setSettings({ completedChallenges: newCompletedIds })

      setCompletedChallenges(newCompletedIds)
      activateChallenge(null)
      setHintRevealed(false)

      toast.success(`Challenge Complete: ${title}`, {
        description: 'Great work! Your progress has been saved.',
        duration: 5000,
        icon: <Trophy size={20} style={{ color: 'var(--proto-dns)' }} />
      })
    } catch (error) {
      console.error('Failed to persist challenge completion:', error)
    } finally {
      if (completionInFlightRef.current === id) {
        completionInFlightRef.current = null
      }
    }
  }

  // Debounced success criteria evaluation (Req 11.3: at most every 500ms)
  useEffect(() => {
    if (!activeChallenge) {
      if (evaluationTimerRef.current) {
        clearTimeout(evaluationTimerRef.current)
        evaluationTimerRef.current = null
      }
      setIsEvaluating(false)
      return
    }

    if (evaluationTimerRef.current) {
      clearTimeout(evaluationTimerRef.current)
    }

    evaluationTimerRef.current = setTimeout(() => {
      void (async () => {
        const now = Date.now()
        if (now - lastEvaluationRef.current < 500) {
          return
        }

        lastEvaluationRef.current = now
        setIsEvaluating(true)

        try {
          const success = activeChallenge.successCriteria(filteredPackets, filterExpression)
          if (success) {
            await handleChallengeSuccess(activeChallenge.id, activeChallenge.title)
          }
        } catch (error) {
          console.error('Challenge evaluation error:', error)
        } finally {
          setIsEvaluating(false)
        }
      })()
    }, 500)

    return () => {
      if (evaluationTimerRef.current) {
        clearTimeout(evaluationTimerRef.current)
      }
    }
  }, [activeChallenge, filteredPackets, filterExpression])

  const handleClose = (): void => {
    activateChallenge(null)
    setHintRevealed(false)
  }

  if (!activeChallenge) {
    return <></>
  }

  const isCompleted = completedChallengeIds.includes(activeChallenge.id)

  return (
    <div
      style={{
        position: 'fixed',
        bottom: 20,
        right: 20,
        width: 400,
        maxHeight: '65vh',
        zIndex: 1000,
        animation: 'slideInFromBottom 200ms ease-out'
      }}
    >
      <Card
        style={{
          backgroundColor: 'var(--nv-bg-surface-1)',
          border: '1px solid var(--nv-border-default)',
          boxShadow: 'var(--nv-shadow-lg)',
          borderRadius: 'var(--nv-radius-lg)'
        }}
      >
        <CardHeader
          style={{
            padding: '16px 20px',
            paddingBottom: 12,
            display: 'flex',
            flexDirection: 'row',
            alignItems: 'flex-start',
            justifyContent: 'space-between',
            borderBottom: '1px solid var(--nv-border-subtle)'
          }}
        >
          <div style={{ flex: 1, minWidth: 0 }}>
            <CardTitle
              style={{
                fontSize: 16,
                fontWeight: 600,
                color: 'var(--nv-text-primary)',
                marginBottom: 4
              }}
            >
              {activeChallenge.title}
              {isCompleted && (
                <Trophy
                  size={16}
                  style={{
                    marginLeft: 8,
                    color: 'var(--proto-dns)',
                    display: 'inline-block',
                    verticalAlign: 'middle'
                  }}
                  aria-label="Completed"
                />
              )}
            </CardTitle>
            <CardDescription
              style={{
                fontSize: 13,
                color: 'var(--nv-text-secondary)'
              }}
            >
              {isCompleted ? 'Challenge completed!' : 'Active challenge'}
            </CardDescription>
          </div>
          <Button
            variant="ghost"
            size="sm"
            onClick={handleClose}
            aria-label="Close challenge"
            style={{
              padding: 4,
              height: 28,
              width: 28,
              flexShrink: 0
            }}
          >
            <X size={16} />
          </Button>
        </CardHeader>

        <CardContent style={{ padding: '16px 20px' }}>
          {/* Goal description */}
          <div style={{ marginBottom: 16 }}>
            <h4
              style={{
                fontSize: 12,
                fontWeight: 600,
                textTransform: 'uppercase',
                letterSpacing: '0.05em',
                color: 'var(--nv-text-tertiary)',
                marginBottom: 8
              }}
            >
              Goal
            </h4>
            <p
              style={{
                fontSize: 14,
                lineHeight: 1.6,
                color: 'var(--nv-text-primary)'
              }}
            >
              {activeChallenge.goal}
            </p>
          </div>

          {/* Hint (reveal on demand) - Req 11.2 */}
          <Collapsible open={hintRevealed} onOpenChange={setHintRevealed}>
            <CollapsibleTrigger asChild>
              <Button
                variant="outline"
                size="sm"
                style={{
                  width: '100%',
                  justifyContent: 'space-between',
                  marginBottom: hintRevealed ? 12 : 0,
                  height: 36
                }}
                aria-expanded={hintRevealed}
                aria-label={hintRevealed ? 'Hide hint' : 'Show hint'}
              >
                <span style={{ fontSize: 13, fontWeight: 500 }}>
                  {hintRevealed ? 'Hide Hint' : 'Show Hint'}
                </span>
                {hintRevealed ? <ChevronDown size={16} /> : <ChevronRight size={16} />}
              </Button>
            </CollapsibleTrigger>
            <CollapsibleContent
              style={{
                marginTop: 12,
                padding: 14,
                backgroundColor: 'var(--nv-bg-surface-2)',
                borderRadius: 'var(--nv-radius-md)',
                border: '1px solid var(--nv-border-subtle)'
              }}
            >
              <p
                style={{
                  fontSize: 13,
                  lineHeight: 1.6,
                  color: 'var(--nv-text-secondary)',
                  margin: 0
                }}
              >
                {activeChallenge.hint}
              </p>
            </CollapsibleContent>
          </Collapsible>

          {/* Evaluation status indicator */}
          {isEvaluating && (
            <div
              style={{
                marginTop: 16,
                padding: 10,
                fontSize: 12,
                color: 'var(--nv-text-tertiary)',
                textAlign: 'center',
                fontStyle: 'italic',
                backgroundColor: 'var(--nv-bg-surface-2)',
                borderRadius: 'var(--nv-radius-sm)'
              }}
              role="status"
              aria-live="polite"
            >
              Evaluating...
            </div>
          )}
        </CardContent>
      </Card>

      <style>{`
        @keyframes slideInFromBottom {
          from {
            transform: translateY(20px);
            opacity: 0;
          }
          to {
            transform: translateY(0);
            opacity: 1;
          }
        }
      `}</style>
    </div>
  )
}
</file>

