 * Req 10.1, 20.1 — contextual help for every non-obvious UI control.
 *
 * @param helpId - Key from help-text.json identifying the control to explain.
 * @param side   - Tooltip placement (default: "top").
 */
export function HelpIcon({
  helpId,
  side = 'top'
}: {
