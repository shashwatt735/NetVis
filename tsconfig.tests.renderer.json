{
    "extends": "./tsconfig.web.json",
    "include": [
        "src/__tests__/renderer/**/*",
        "src/renderer/src/**/*",
        "src/shared/**/*",
        "src/preload/*.d.ts"
    ],
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": [
            "node",
            "vitest/globals",
            "@testing-library/jest-dom"
        ],
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "baseUrl": ".",
        "paths": {
            "@renderer/*": [
                "src/renderer/src/*"
            ]
        },
        "noUnusedLocals": false,
        "noUnusedParameters": false
    }
}
